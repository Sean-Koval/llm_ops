#\!/usr/bin/env python
"""API server for serving machine learning models."""

import argparse
import logging
import os
import sys
import uvicorn
from typing import Optional, Dict, Any, List, Union

from fastapi import FastAPI, HTTPException, Request
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from llm_ops_pipeline.inference.predictor import predict_text
from llm_ops_pipeline.model.model_loader import load_model_and_tokenizer
from llm_ops_pipeline.utils.logging import setup_logger

# Models
class PredictionRequest(BaseModel):
    """Request model for prediction API."""
    text: str
    options: Optional[Dict[str, Any]] = None


class PredictionResponse(BaseModel):
    """Response model for prediction API."""
    prediction: Union[str, List[Dict[str, float]]]
    processing_time: float


# Setup
logger = setup_logger("api_server")
app = FastAPI(title="LLM Ops Pipeline API")

# Add CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Global variables
MODEL = None
TOKENIZER = None
SKIP_MODEL_LOAD = False


def main():
    """Main function to start the API server."""
    parser = argparse.ArgumentParser(description="Start the API server")
    parser.add_argument("--model_path", type=str, required=True, help="Path to the model")
    parser.add_argument("--host", type=str, default="127.0.0.1", help="Host to run the server on")
    parser.add_argument("--port", type=int, default=8000, help="Port to run the server on")
    parser.add_argument("--skip_model_load", type=str, default="false", help="Skip model loading for testing")
    args = parser.parse_args()

    global MODEL, TOKENIZER, SKIP_MODEL_LOAD
    SKIP_MODEL_LOAD = args.skip_model_load.lower() == "true"
    
    if not SKIP_MODEL_LOAD:
        logger.info(f"Loading model from {args.model_path}")
        model, tokenizer = load_model_and_tokenizer(
            model_path=args.model_path,
            model_type="causal_lm"
        )
        MODEL = model
        TOKENIZER = tokenizer
    else:
        logger.info("Skipping model loading for testing")

    uvicorn.run(app, host=args.host, port=args.port)


@app.get("/health")
async def health_check():
    """Health check endpoint."""
    if not SKIP_MODEL_LOAD and (MODEL is None or TOKENIZER is None):
        raise HTTPException(status_code=503, detail="Model not loaded")
    return {"status": "ok"}


@app.post("/predict", response_model=PredictionResponse)
async def predict(request: PredictionRequest):
    """Prediction endpoint."""
    if not SKIP_MODEL_LOAD and (MODEL is None or TOKENIZER is None):
        raise HTTPException(status_code=503, detail="Model not loaded")
    
    if SKIP_MODEL_LOAD:
        # Return dummy response for testing
        import time
        return {
            "prediction": "This is a dummy prediction for testing",
            "processing_time": 0.1
        }
        
    options = request.options or {}
    prediction, processing_time = predict_text(
        MODEL, TOKENIZER, request.text, **options
    )
    
    return {
        "prediction": prediction,
        "processing_time": processing_time
    }


if __name__ == "__main__":
    main()
